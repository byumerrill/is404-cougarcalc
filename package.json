{
  "name": "cougarcalc",
  "version": "1.0.0",
  "description": "A calculator web app with persistent PostgreSQL history",
  "main": "app.js",
  "scripts": {
    "bundle": "node scripts/deployment-bundle.js",
    "bundle:inspect": "node scripts/deployment-bundle.js --inspect",
    "smoke:degraded": "node scripts/degraded-smoke.js",
    "start": "node app.js",
    "test": "node --test"
  },
  "engines": {
    "node": "22.x"
  },
  "keywords": [
    "calculator",
    "express",
    "node",
    "postgresql"
  ],
  "author": "OpenAI",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.22.0"
  },
  "overrides": {
    "body-parser": "1.20.6"
  }
}
